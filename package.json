{
  "name": "work-tree-garden",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "wtg": "index.ts"
  },
  "scripts": {
    "build": "bun run build:mac && bun run build:linux && bun run build:windows",
    "build:mac": "bun build ./index.ts --compile --minify --bytecode --target=bun-darwin-arm64 --outfile dist/wtg-mac",
    "build:linux": "bun build ./index.ts --compile --minify --bytecode --target=bun-linux-x64 --outfile dist/wtg-linux",
    "build:windows": "bun build ./index.ts --compile --minify --bytecode --target=bun-windows-x64 --outfile dist/wtg-windows.exe"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  }
}
